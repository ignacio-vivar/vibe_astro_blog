---
interface Props {
  src: string;
  titulo: string;
  description?: string;
}

const { src, titulo, description } = Astro.props;
---

<a
  href={src}
  target="_blank"
  rel="noopener noreferrer"
  class="group flex items-center gap-4 p-4 my-6 rounded-2xl border border-primary/20 bg-base-200/50 hover:bg-base-200 hover:border-primary/50 transition-all duration-300 shadow-sm hover:shadow-md not-prose no-underline"
>
  <div class="flex flex-shrink-0 items-center justify-center w-12 h-12 rounded-xl bg-primary/10 text-primary group-hover:bg-primary/20 transition-colors">
    <svg xmlns="http://www.w3.org/2000/svg" class="w-6 h-6" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
      <path d="M14 2H6a2 2 0 0 0-2 2v16a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2V8z"></path>
      <polyline points="14 2 14 8 20 8"></polyline>
      <line x1="16" y1="13" x2="8" y2="13"></line>
      <line x1="16" y1="17" x2="8" y2="17"></line>
      <polyline points="10 9 9 9 8 9"></polyline>
    </svg>
  </div>
  
  <div class="flex-1 min-w-0">
    <h3 class="font-semibold text-base-content m-0 text-base truncate group-hover:text-primary transition-colors">
      {titulo}
    </h3>
    {description && (
      <p class="text-sm text-base-content/60 m-0 mt-0.5 truncate">
        {description}
      </p>
    )}
  </div>

  <div class="flex-shrink-0 btn btn-sm btn-ghost text-primary opacity-80 group-hover:opacity-100 hidden sm:inline-flex">
    Descargar / Abrir
    <svg xmlns="http://www.w3.org/2000/svg" class="w-4 h-4 ml-1" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
      <line x1="7" y1="17" x2="17" y2="7"></line>
      <polyline points="7 7 17 7 17 17"></polyline>
    </svg>
  </div>
</a>
