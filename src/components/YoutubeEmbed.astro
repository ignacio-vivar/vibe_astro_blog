---
interface Props {
  id: string;
  titulo?: string;
}

const { id, titulo = 'Video de YouTube' } = Astro.props;
---

<div class="my-8 rounded-2xl overflow-hidden border border-primary/10 bg-base-200/60 backdrop-blur-sm shadow-lg not-prose">
  <div class="flex items-center gap-3 px-5 py-3 bg-base-300/50 border-b border-primary/10">
    <span class="text-lg">🎥</span>
    <span class="font-medium text-sm">{titulo}</span>
    <a
      href={`https://www.youtube.com/watch?v=${id}`}
      target="_blank"
      rel="noopener noreferrer"
      class="ml-auto btn btn-xs btn-ghost text-primary hover:bg-primary/10 gap-1"
    >
      Ver en YouTube ↗
    </a>
  </div>
  <div style="position: relative; padding-bottom: 56.25%; height: 0;">
    <iframe
      src={`https://www.youtube.com/embed/${id}`}
      style="position: absolute; top: 0; left: 0; width: 100%; height: 100%; border: 0;"
      allow="accelerometer; autoplay; clipboard-write; encrypted-media; gyroscope; picture-in-picture; web-share"
      allowfullscreen
      loading="lazy"
      title={titulo}
    ></iframe>
  </div>
</div>
