---
interface Props {
  src: string;
  titulo?: string;
}

const { src, titulo = 'Documento PDF' } = Astro.props;
---

<div class="my-8 rounded-2xl overflow-hidden border border-primary/10 bg-base-200/60 backdrop-blur-sm shadow-lg not-prose">
  <div class="flex items-center gap-3 px-5 py-3 bg-base-300/50 border-b border-primary/10">
    <span class="text-lg">📄</span>
    <span class="font-medium text-sm">{titulo}</span>
    <a
      href={src}
      target="_blank"
      rel="noopener noreferrer"
      class="ml-auto btn btn-xs btn-ghost text-primary hover:bg-primary/10 gap-1"
    >
      Abrir ↗
    </a>
  </div>
  <iframe
    src={src}
    class="w-full border-0"
    style="height: 700px"
    title={titulo}
    loading="lazy"
  ></iframe>
</div>
