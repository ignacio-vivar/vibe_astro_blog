---
interface Props {
  title: string;
  description: string;
  href: string;
  unitNumber: number;
}

const { title, description, href, unitNumber } = Astro.props;
---

<a
  href={href}
  class="group block rounded-xl overflow-hidden border border-primary/10 bg-base-200/40 backdrop-blur-sm hover:border-primary/30 hover:bg-base-200/70 transition-all duration-300 hover:shadow-lg hover:shadow-primary/5"
>
  <div class="p-6 flex gap-5 items-start">
    <!-- Unit number badge -->
    <div class="flex-shrink-0 w-12 h-12 rounded-xl bg-gradient-to-br from-primary to-secondary flex items-center justify-center font-display text-lg font-bold text-white shadow-lg shadow-primary/20 group-hover:scale-110 transition-transform duration-300">
      {unitNumber}
    </div>
    <div class="flex-1 min-w-0">
      <h3 class="font-display font-semibold text-base-content group-hover:text-primary transition-colors duration-300 mb-1">
        {title}
      </h3>
      <p class="text-sm text-base-content/60 leading-relaxed">
        {description}
      </p>
    </div>
    <!-- Arrow -->
    <svg class="w-5 h-5 text-base-content/30 group-hover:text-primary flex-shrink-0 mt-1 transform group-hover:translate-x-1 transition-all duration-300" fill="none" viewBox="0 0 24 24" stroke="currentColor">
      <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 5l7 7-7 7" />
    </svg>
  </div>
</a>
