---
interface Props {
  title: string;
  description: string;
  href: string;
  icon: string;
  gradient: string;
  delay?: number;
}

const { title, description, href, icon, gradient, delay = 0 } = Astro.props;
---

<a
  href={href}
  class="group relative block rounded-2xl overflow-hidden border border-primary/10 bg-base-200/60 backdrop-blur-sm hover:border-primary/30 transition-all duration-500 hover:scale-[1.02] hover:shadow-xl hover:shadow-primary/10"
  style={`animation-delay: ${delay}ms`}
>
  <!-- Gradient overlay on hover -->
  <div class={`absolute inset-0 opacity-0 group-hover:opacity-100 transition-opacity duration-500 bg-gradient-to-br ${gradient}`}></div>

  <div class="relative p-8">
    <!-- Icon -->
    <div class="text-5xl mb-5 transform group-hover:scale-110 transition-transform duration-300">
      {icon}
    </div>

    <!-- Title -->
    <h3 class="font-display text-xl font-bold mb-3 text-base-content group-hover:text-primary-content transition-colors duration-300">
      {title}
    </h3>

    <!-- Description -->
    <p class="text-sm text-base-content/70 group-hover:text-primary-content/80 transition-colors duration-300 leading-relaxed">
      {description}
    </p>

    <!-- Arrow indicator -->
    <div class="mt-5 flex items-center gap-2 text-primary group-hover:text-primary-content transition-colors duration-300">
      <span class="text-sm font-medium">Explorar contenido</span>
      <svg class="w-4 h-4 transform group-hover:translate-x-1 transition-transform duration-300" fill="none" viewBox="0 0 24 24" stroke="currentColor">
        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M17 8l4 4m0 0l-4 4m4-4H3" />
      </svg>
    </div>
  </div>
</a>
