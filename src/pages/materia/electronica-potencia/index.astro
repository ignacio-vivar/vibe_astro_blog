---
import BaseLayout from "../../../layouts/BaseLayout.astro";
import UnidadCard from "../../../components/UnidadCard.astro";

const unidades = [
  {
    title: "Criterios de evaluación",
    description: "Criterios de evaluación y pautas",
    href: "/materia/electronica-potencia/unidad-1",
    unitNumber: 1,
  },
  {
    title: "Semiconductores",
    description: "Contenidos y recursos de semiconductores",
    href: "/materia/electronica-potencia/unidad-2",
    unitNumber: 2,
  },
  {
    title: "Diodos",
    description: "Diodos todo el contenido",
    href: "/materia/electronica-potencia/unidad-3",
    unitNumber: 3,
  },
  {
    title: "Transistores BJT",
    description: "Introducción a Transistores BJT",
    href: "/materia/electronica-potencia/unidad-4",
    unitNumber: 4,
  },
  {
    title: "Transistores BJT - Polarización en Continua",
    description: "Trabajo Práctico Transistores",
    href: "/materia/electronica-potencia/unidad-5",
    unitNumber: 5,
  },
  //    {
  //   title: "Transistores Introducción",
  //   description: "Transistores BJT",
  //   href: "/materia/electronica-potencia/unidad-6",
  //   unitNumber: 6,
  // },
];
---

<BaseLayout
  title="Electrónica de Potencia"
  description="Contenido de estudio de Electrónica de Potencia"
>
  <div class="text-sm breadcrumbs mb-8">
    <ul>
      <li><a href="/" class="text-primary hover:text-primary/80">Inicio</a></li>
      <li class="text-base-content/50">Electrónica de Potencia</li>
    </ul>
  </div>

  <div class="flex items-center gap-4 mb-10">
    <div class="w-14 h-14 flex items-center justify-center">
      <img
        src="/icons/ep_icon.svg"
        class="w-full h-full object-contain brightness-0 invert opacity-90"
        alt="Icono"
      />
    </div>
    <div>
      <h1 class="font-display text-3xl md:text-4xl font-bold text-base-content">
        Electrónica de Potencia
      </h1>
      <p class="text-base-content/50 mt-1">
        Contenido de estudio organizado por unidades
      </p>
    </div>
  </div>

  <div class="space-y-4">
    {
      unidades.map((unidad) => (
        <UnidadCard
          title={unidad.title}
          description={unidad.description}
          href={unidad.href}
          unitNumber={unidad.unitNumber}
        />
      ))
    }
  </div>
</BaseLayout>
