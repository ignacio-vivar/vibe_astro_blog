---
import BaseLayout from "../../../layouts/BaseLayout.astro";
import UnidadCard from "../../../components/UnidadCard.astro";

const unidades = [
  {
    title: "Criterios de Evaluación y Pautas",
    description: "Criterios de evaluación y pautas",
    href: "/materia/tecnologia-energia/unidad-1",
    unitNumber: 1,
  },
  {
    title: "Energía Eólica",
    description: "Contenido de energía eólica",
    href: "/materia/tecnologia-energia/unidad-2",
    unitNumber: 2,
  },
  {
    title: "Petróleo y Gas",
    description: "Contenido de petróleo y gas",
    href: "/materia/tecnologia-energia/unidad-3",
    unitNumber: 3,
  },
  {
    title: "Almacenamiento Energético",
    description: "Contenido de almacenamiento energético",
    href: "/materia/tecnologia-energia/unidad-4",
    unitNumber: 4,
  },
  {
    title: "Almacenamiento Energético - Corrección Compresión de aire",
    description: "Corrección",
    href: "/materia/tecnologia-energia/unidad-5",
    unitNumber: 5,
  },
];
---

<BaseLayout
  title="Tecnología de la Energía"
  description="Contenido de estudio de Tecnología de la Energía"
>
  <!-- Breadcrumb -->
  <div class="text-sm breadcrumbs mb-8">
    <ul>
      <li><a href="/" class="text-primary hover:text-primary/80">Inicio</a></li>
      <li class="text-base-content/50">Tecnología de la Energía</li>
    </ul>
  </div>

  <!-- Header -->
  <div class="flex items-center gap-4 mb-10">
    <div class="w-14 h-14 flex items-center justify-center">
      <img
        src="/icons/te_icon.svg"
        class="w-full h-full object-contain bg-gray-600 rounded-xl p-2"
        alt="Icono"
      />
    </div>
    <div>
      <h1 class="font-display text-3xl md:text-4xl font-bold text-base-content">
        Tecnología de la Energía
      </h1>
      <p class="text-base-content/50 mt-1">
        Apuntes de tecnología de la energía
      </p>
    </div>
  </div>

  <!-- Unidades -->
  <div class="space-y-4">
    {
      unidades.map((unidad) => (
        <UnidadCard
          title={unidad.title}
          description={unidad.description}
          href={unidad.href}
          unitNumber={unidad.unitNumber}
        />
      ))
    }
  </div>
</BaseLayout>
