---
import BaseLayout from "../../../layouts/BaseLayout.astro";
import UnidadCard from "../../../components/UnidadCard.astro";

const unidades = [
  {
    title: "Introducción a la Energía",
    description:
      "Conceptos fundamentales de energía, formas de energía y principios de conservación.",
    href: "/materia/tecnologia-energia/unidad-1",
    unitNumber: 1,
  },
  // {
  //   title: 'Fuentes de Energía Convencionales',
  //   description: 'Combustibles fósiles, energía nuclear, centrales térmicas y sus impactos.',
  //   href: '/materia/tecnologia-energia/unidad-2',
  //   unitNumber: 2,
  // },
];
---

<BaseLayout
  title="Tecnología de la Energía"
  description="Contenido de estudio de Tecnología de la Energía"
>
  <!-- Breadcrumb -->
  <div class="text-sm breadcrumbs mb-8">
    <ul>
      <li><a href="/" class="text-primary hover:text-primary/80">Inicio</a></li>
      <li class="text-base-content/50">Tecnología de la Energía</li>
    </ul>
  </div>

  <!-- Header -->
  <div class="flex items-center gap-4 mb-10">
    <div class="text-5xl">⚡</div>
    <div>
      <h1 class="font-display text-3xl md:text-4xl font-bold text-base-content">
        Tecnología de la Energía
      </h1>
      <p class="text-base-content/50 mt-1">
        Fuentes de energía, tecnologías de conversión y sistemas energéticos
      </p>
    </div>
  </div>

  <!-- Unidades -->
  <div class="space-y-4">
    {
      unidades.map((unidad) => (
        <UnidadCard
          title={unidad.title}
          description={unidad.description}
          href={unidad.href}
          unitNumber={unidad.unitNumber}
        />
      ))
    }
  </div>
</BaseLayout>
