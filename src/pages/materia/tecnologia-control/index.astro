---
import BaseLayout from "../../../layouts/BaseLayout.astro";
import UnidadCard from "../../../components/UnidadCard.astro";

const unidades = [
  {
    title: "Criterios de evaluación",
    description: "Criterios de evaluación y pautas",
    href: "/materia/tecnologia-control/unidad-1",
    unitNumber: 1,
  },
  {
    title: "Introducción de teoría de control",
    description: "Material de lectura y consignas.",
    href: "/materia/tecnologia-control/unidad-2",
    unitNumber: 2,
  },
  {
    title: "Definiciones elementales de teoría de control",
    description: "Material de lectura y consignas.",
    href: "/materia/tecnologia-control/unidad-3",
    unitNumber: 3,
  },
  {
    title: "Python - Estructura de Datos",
    description: "Material de lectura y ejercicios - Estructura de Datos",
    href: "/materia/tecnologia-control/unidad-4",
    unitNumber: 4,
  },
   {
    title: "Python - Sentencias Lógicas - Bucle For",
    description: "Material de lectura y ejercicios - Sentencias Lógicas - Bucle For",
    href: "/materia/tecnologia-control/unidad-5",
    unitNumber: 5,
  },
];
---

<BaseLayout
  title="Tecnología de Control"
  description="Contenido de estudio de Tecnología de Control"
>
  <div class="text-sm breadcrumbs mb-8">
    <ul>
      <li><a href="/" class="text-primary hover:text-primary/80">Inicio</a></li>
      <li class="text-base-content/50">Tecnología de Control</li>
    </ul>
  </div>

  <div class="flex items-center gap-4 mb-10">
    <div class="w-14 h-14 flex items-center justify-center">
      <img
        src="/icons/tc_icon.svg"
        class="w-full h-full object-contain brightness-0 invert opacity-90"
        alt="Icono"
      />
    </div>
    <div>
      <h1 class="font-display text-3xl md:text-4xl font-bold text-base-content">
        Tecnología de Control
      </h1>
      <p class="text-base-content/50 mt-1">
        Contenido de estudio organizado por unidades
      </p>
    </div>
  </div>

  <div class="space-y-4">
    {
      unidades.map((unidad) => (
        <UnidadCard
          title={unidad.title}
          description={unidad.description}
          href={unidad.href}
          unitNumber={unidad.unitNumber}
        />
      ))
    }
  </div>
</BaseLayout>
