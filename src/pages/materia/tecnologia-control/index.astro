---
import BaseLayout from '../../../layouts/BaseLayout.astro';
import UnidadCard from '../../../components/UnidadCard.astro';

const unidades = [
  {
    title: 'Unidad 1',
    description: 'Contenido pendiente.',
    href: '/materia/tecnologia-control/unidad-1',
    unitNumber: 1,
  },
  {
    title: 'Unidad 2',
    description: 'Contenido pendiente.',
    href: '/materia/tecnologia-control/unidad-2',
    unitNumber: 2,
  },
  {
    title: 'Unidad 3',
    description: 'Contenido pendiente.',
    href: '/materia/tecnologia-control/unidad-3',
    unitNumber: 3,
  },
];
---

<BaseLayout title="Tecnología de Control" description="Contenido de estudio de Tecnología de Control">
  <div class="text-sm breadcrumbs mb-8">
    <ul>
      <li><a href="/" class="text-primary hover:text-primary/80">Inicio</a></li>
      <li class="text-base-content/50">Tecnología de Control</li>
    </ul>
  </div>

  <div class="flex items-center gap-4 mb-10">
    <div class="text-5xl">🎛️</div>
    <div>
      <h1 class="font-display text-3xl md:text-4xl font-bold text-base-content">Tecnología de Control</h1>
      <p class="text-base-content/50 mt-1">Contenido de estudio organizado por unidades</p>
    </div>
  </div>

  <div class="space-y-4">
    {unidades.map((unidad) => (
      <UnidadCard
        title={unidad.title}
        description={unidad.description}
        href={unidad.href}
        unitNumber={unidad.unitNumber}
      />
    ))}
  </div>
</BaseLayout>
